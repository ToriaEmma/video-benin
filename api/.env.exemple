# Chaine de connexion du projet Neon.
# Console Neon -> votre projet -> Connect -> « Connection string ».
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Secret de signature des jetons de session. Prenez une longue chaine
# aleatoire, par exemple la sortie de :  openssl rand -base64 48
JWT_SECRET=changez-cette-valeur

# Port d'ecoute de l'API.
PORT=4000

# Stockage objet Neon (hebergement des fichiers video).
# Console Neon -> votre projet -> Storage -> « Default object storage
# credential ». L'identifiant est le token_id (nak_live_...), le secret
# est la cle « s3_secret_access_key » (nsk_live_...), montree une seule
# fois a la creation : si elle est perdue, faites tourner le credential.
STOCKAGE_CLE_ACCES=nak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STOCKAGE_CLE_SECRETE=nsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatifs : ces valeurs par defaut correspondent deja au projet.
# Le seau doit etre en lecture publique (« public_read ») pour qu'une
# video soit jouable depuis un autre appareil.
STOCKAGE_SEAU=videos-publiques
STOCKAGE_REGION=eu-central-1
STOCKAGE_ENDPOINT=https://br-long-snow-b2sxuksr.storage.c-6.eu-central-1.aws.neon.tech
